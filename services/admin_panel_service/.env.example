# Общий Postgres (services/shared_postgres), своя схема admin_panel внутри общей БД
DATABASE_URL=postgresql+psycopg2://pravburo:pravburo@shared_postgres:5432/pravburo
DB_SCHEMA=admin_panel

# ВАЖНО: этот секрет должен совпадать с JWT_SECRET модулей, которые должны принимать
# единый вход из хаба (сейчас — services/leadreport_service/.env). Токен, выданный здесь,
# проверяется модулями по claim'у is_staff, без отдельного логина.
# Также должен совпадать с SSO_JWT_SECRET в .env бот-админки (admin.prav-buro.ru,
# отдельный сервер/репозиторий) — значение уже согласовано и прописано на обеих
# сторонах вручную, здесь ничего менять не нужно.
JWT_SECRET=shared-staff-sso-secret-dev-only
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=720

# Refresh-токен (httponly-кука) — сколько дней он живёт, пока клиент тихо
# перевыпускает access_token через POST /auth/refresh вместо релогина.
REFRESH_TOKEN_EXPIRES_DAYS=7
# ОБЯЗАТЕЛЬНО true на проде (сайт по HTTPS) — иначе браузер не примет
# ни refresh-куку, ни куку из /auth/sso-exchange, и SSO/refresh будут молча
# не работать. false — только для локальной разработки по http.
COOKIE_SECURE=false
