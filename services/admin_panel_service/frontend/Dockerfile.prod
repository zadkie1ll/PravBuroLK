# Прод-сборка: билдим статику Vite, отдаём через nginx-контейнер (не dev-сервер).
# Отдельный файл от Dockerfile (тот остаётся для локальной разработки с `npm run dev`).
FROM node:20-slim AS build
WORKDIR /app
COPY package.json ./
RUN npm install
COPY . .

# Vite инлайнит VITE_* переменные в статику на этапе сборки, поэтому это build arg,
# а не runtime environment (docker-compose environment: тут не сработает).
ARG VITE_API_BASE_URL=""
ARG VITE_URLSHORTER_BASE_URL=""
ARG VITE_LEADREPORT_BASE_URL=""
ARG VITE_REFERRAL_STATS_BASE_URL=""
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_URLSHORTER_BASE_URL=$VITE_URLSHORTER_BASE_URL
ENV VITE_LEADREPORT_BASE_URL=$VITE_LEADREPORT_BASE_URL
ENV VITE_REFERRAL_STATS_BASE_URL=$VITE_REFERRAL_STATS_BASE_URL
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 5176
