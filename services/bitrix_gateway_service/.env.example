INTERNAL_TOKEN=

BITRIX_PROFILE_DEFAULT_WEBHOOK_URL=
BITRIX_PROFILE_DOCUMENTS_WEBHOOK_URL=
BITRIX_PROFILE_MESSAGING_WEBHOOK_URL=
BITRIX_PROFILE_CONSULTATION_WEBHOOK_URL=

# Embedded module: new lead phone normalization (no new container).
LEAD_PHONE_ENABLED=false
LEAD_PHONE_SECRET=
LEAD_PHONE_PROFILE=consultation
LEAD_PHONE_FROM_TYPE=OTHER
LEAD_PHONE_TO_TYPE=WORK
LEAD_CONTACT_PHONE_FIELD=UF_CRM_68931B5269702
LEAD_CONTACT_STAGE_ID=CONVERTED
# Empty = all sources; otherwise comma-separated CRM source IDs.
LEAD_PHONE_ALLOWED_SOURCES=
# Start with dry-run: reads/logs counts but never writes to Bitrix.
LEAD_PHONE_DRY_RUN=true
LEAD_PHONE_MAX_ATTEMPTS=8
LEAD_PHONE_RETRY_SECONDS=2
LEAD_PHONE_QUEUE_PATH=/data/lead_phone/jobs.sqlite3
