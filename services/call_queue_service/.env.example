# Общий Postgres (services/shared_postgres), своя схема call_queue внутри общей БД
DATABASE_URL=postgresql+psycopg2://pravburo:pravburo@shared_postgres:5432/pravburo
DB_SCHEMA=call_queue

JWT_SECRET=dev-insecure-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=720

# Монолит (для локального прототипа — как видит его backend-контейнер;
# на macOS/Windows Docker Desktop host.docker.internal резолвится в хост-машину)
MONOLITH_BASE_URL=http://host.docker.internal:8000
MONOLITH_INTERNAL_TOKEN=

BITRIX_GATEWAY_BASE_URL=http://host.docker.internal:8002
BITRIX_GATEWAY_TOKEN=
BITRIX_GATEWAY_PROFILE=default

# Оставлено только для построения ссылок на сделки (deal_service.build_entity_url)
BITRIX_WEBHOOK_URL=
CALL_QUEUE_BITRIX_TIME_ZONE=Europe/Moscow

MEGAFON_VATS_API_URL=
MEGAFON_VATS_API_KEY=
MEGAFON_VATS_AUTH_HEADER=X-API-KEY
MEGAFON_VATS_AUTH_MODE=header
MEGAFON_VATS_CRM_AUTH_KEY=

# Пока монолит и этот сервис работают параллельно на одном вебхуке от MegaFon — форвардим
# копию каждого события в монолит, чтобы его собственная очередь звонков тоже продолжала
# получать статусы. Пусто = форвардинг выключен (только этот сервис получает события).
MEGAFON_WEBHOOK_FORWARD_URL=
