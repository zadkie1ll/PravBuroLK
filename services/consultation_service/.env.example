# Все запросы к Bitrix идут через bitrix_gateway_service, профиль "consultation" —
# нужно завести BITRIX_PROFILE_CONSULTATION_WEBHOOK_URL в его .env (свой вебхук,
# отдельный от documents/messaging).
BITRIX_GATEWAY_BASE_URL=http://host.docker.internal:8002
BITRIX_GATEWAY_TOKEN=
BITRIX_GATEWAY_PROFILE=consultation

TOKEN_SECRET_KEY=change-me-in-prod
TOKEN_SIGN_SALT=consultation.report

# В проде — свой поддомен (не под panel.prav-buro.ru): pdf.prav-buro.ru.
# PRINT_BASE_URL — как backend видит фронтенд сам: локально (dev) через docker-сеть
# по имени контейнера, в проде (network_mode: host) — просто 127.0.0.1.
PUBLIC_BASE_URL=https://pdf.prav-buro.ru
PRINT_BASE_URL=http://127.0.0.1:5180

# Поля сделки Bitrix — подтверждены реальным кодом монолита (bitrix/views.py:
# build_consultation) по сделке 16778. См. app/config.py.
FIELD_CLIENT_NAME=TITLE
FIELD_CONSULTATION_DATE=DATE_CREATE
FIELD_PROPERTY=UF_CRM_1754647601622
FIELD_INCOME=UF_CRM_1770129399154
FIELD_TRANSACTIONS=UF_CRM_1754647663541
FIELD_MARRIAGE=UF_CRM_1754647902223
