# Прод-сборка: билдим статику Vite под путём /consultation/ (сервис живёт на
# panel.prav-buro.ru/consultation, не на своём поддомене), отдаём через nginx-контейнер.
FROM node:20-slim AS build
WORKDIR /app
COPY package.json ./
RUN npm install
COPY . .

ARG VITE_API_BASE_URL=""
ARG DEPLOY_BASE_PATH="/"
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build -- --base=$DEPLOY_BASE_PATH

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf.template /etc/nginx/templates/default.conf.template
EXPOSE 5180
