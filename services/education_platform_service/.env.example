# Общий Postgres (services/shared_postgres), своя схема education_platform внутри общей БД
DATABASE_URL=postgresql+psycopg2://pravburo:pravburo@shared_postgres:5432/pravburo
DB_SCHEMA=education_platform

JWT_SECRET=dev-insecure-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=720

# Путь на хосте к private_media монолита (BASE_DIR/private_media), пробрасывается read-only.
MONOLITH_PRIVATE_MEDIA_PATH=../../private_media
MEDIA_ROOT=/private_media
